# ── Google Drive ──────────────────────────────────────────────────────────────

# Root folder ID in Google Drive where all shows/episodes are stored
ZOOMIES_DRIVE_ROOT_FOLDER_ID=your_root_folder_id_here

# Option A — Service Account (required for hosted/Railway deployment)
# Paste the full JSON content of your service account key file as a single line
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"..."}

# Option B — OAuth (local dev only, not needed if using service account)
# GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your_client_secret

# ── AI APIs ───────────────────────────────────────────────────────────────────

# Used for: Claude (script extraction + prompts)
ANTHROPIC_API_KEY=sk-ant-...

# Used for: Imagen 4 (frames) + Gemini TTS (voices)
GEMINI_API_KEY=AIza...

# ── Slack ─────────────────────────────────────────────────────────────────────

# Bot token for pipeline notifications (optional)
ZOOMIES_SLACK_BOT_TOKEN=xoxb-...

# Channel to post notifications into — quote the value to avoid # being treated as a comment
ZOOMIES_SLACK_CHANNEL="#zoomies-production"

# ── App URL (used to generate approval links in Slack notifications) ──────────

# Set to your Railway custom domain (or Railway-assigned URL)
APP_URL=https://zoomies.yourdomain.com

# ── Hosted server auth ────────────────────────────────────────────────────────

# Shared access token for team members — set this to anything secret
# Leave unset for open/local access (no login required)
TEAM_TOKEN=change_me_to_something_secret

# Server port (Railway sets this automatically; override locally if needed)
PORT=3333
